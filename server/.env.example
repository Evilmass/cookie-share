PORT=3000
# Plain HTTP: listen on loopback and put a TLS reverse proxy in front.
# (Docker Compose overrides this inside the container and publishes the port
# on 127.0.0.1 of the host instead.)
HOST=127.0.0.1

# Three different random values. Generate each one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# The server refuses to start with these placeholders, with reused values, or
# with an ADMIN_PASSWORD / TRANSPORT_SECRET shorter than 16 characters.
PATH_SECRET=change-me
ADMIN_PASSWORD=change-me
TRANSPORT_SECRET=change-me

DB_PATH=./data/cookie_share.db

# Set to true when exactly one reverse proxy sits in front of the server, so
# rate limits apply per client address (X-Forwarded-For) instead of per proxy.
# Leave unset when clients connect directly: the header would be spoofable.
# TRUST_PROXY=true

# Escape hatch for an existing deployment that cannot rotate a short secret
# yet. Short secrets can be brute-forced offline from any captured response.
# ALLOW_WEAK_SECRETS=true
